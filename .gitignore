.env
.env.local
.env.*.local
.env.bak

# ブラウザログインセッション（note storage_state 等・機密・コミット禁止）
.auth/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# 投稿ログ: threads.jsonl のみ追跡（自動投稿の冪等化・インサイト測定・監査の共有真実源）。
# 他プラットフォームのログは当面ローカル保管。
docs/posted_log/*
!docs/posted_log/threads.jsonl

