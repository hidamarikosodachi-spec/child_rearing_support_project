# ============================================================
# ひだまりこそだち 自動投稿用 環境変数テンプレート
# ------------------------------------------------------------
# 使い方:
#   cp .env.example .env
#   .env を編集して実際の値を入れる
#   .env は .gitignore 済みなので Git に commit されない
# ============================================================

# ----- X (Twitter) -----
# https://developer.x.com/ で取得
# OAuth 2.0 PKCE: tweet.write スコープ
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ----- Meta (Threads + Instagram) -----
# https://developers.facebook.com/ でアプリ登録
# Threads と Instagram は同じ Meta インフラを共有
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_THREADS_USER_ID=
META_INSTAGRAM_BUSINESS_ID=
META_FB_PAGE_ID=

# ----- note (Playwright) -----
# ブラウザ自動操作用のログイン情報
# 公式 API が無いため Playwright で代替
NOTE_EMAIL=
NOTE_PASSWORD=

# ----- Cloudflare R2 (Instagram 画像ホスティング用) -----
# https://dash.cloudflare.com/ → R2 → API トークン作成
# 無料枠 10GB ストレージ + 10GB egress/月
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hidamari-kosodachi-images
R2_PUBLIC_URL=

# ----- ログレベル -----
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Cloudflare（診断サイト: Pages + Workers + D1 / T114）---
# ダッシュボード → 右上アイコン → プロフィール → API トークン → トークンを作成 →「カスタムトークンを作成」
# 権限: アカウント / Workers スクリプト / 編集 ・ アカウント / D1 / 編集 ・ アカウント / Cloudflare Pages / 編集
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
